// rules_version = '2'
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { 
      return request.auth != null; 
    }
    function isOwner(userId) { 
      return request.auth.uid == userId; 
    }
    function isAdmin() {
      // CRITICAL: Check if user doc exists first to avoid errors for new users
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Activity Logs (New)
    match /activity_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    match /users/{userId} {
      // SIMPLIFIED: Allow users to read/create their own data
      // Don't check isAdmin() on read to avoid circular dependency for new users
      allow read, create: if isOwner(userId);
      
      // Admins can read any user
      allow read: if isAdmin();
      
      // Allow users to update their own data or admin can update any
      allow update: if isOwner(userId) || isAdmin();
      
      // Only admin can delete users
      allow delete: if isAdmin();

      match /profiles/{profileId} {
        allow read, write, create: if isOwner(userId) || isAdmin();
      }

      match /billing/{invoiceId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      match /paymentMethods/{methodId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /requests/{requestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
