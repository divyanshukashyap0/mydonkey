// rules_version = '2'
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { 
      return request.auth != null; 
    }
    function isOwner(userId) { 
      return request.auth.uid == userId; 
    }
    function isAdmin() {
      // CRITICAL: Check if user doc exists first to avoid errors for new users
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Activity Logs (New)
    match /activity_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
    }

    match /users/{userId} {
      // SIMPLIFIED: Allow users to read/create their own data
      // Don't check isAdmin() on read to avoid circular dependency for new users
      allow read, create: if isOwner(userId);
      
      // Admins can read any user
      allow read: if isAdmin();
      
      // Allow users to update their own data EXCEPT critical fields (role, plan, status)
      allow update: if (isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'subscriptionStatus', 'email']))
      ) || isAdmin();
      
      // Only admin can delete users
      allow delete: if isAdmin();

      match /profiles/{profileId} {
        allow read, write, create: if isOwner(userId) || isAdmin();
      }

      match /billing/{invoiceId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      match /paymentMethods/{methodId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /content/{contentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /requests/{requestId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content_contributions/{docId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    match /qr_sessions/{sessionId} {
      // Web can create session
      allow create: if true;
      // Anyone can read (so web can listen to it, though technically we can restrict by sessionId)
      allow read: if true;
      // Mobile app updates to approved
      allow update: if isAuthenticated() && request.resource.data.status == 'approved' && request.resource.data.userId == request.auth.uid;
      // Cleanup by function
      allow delete: if false; 
    }

    match /user_sessions/{sessionId} {
      // Users can see their own sessions
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
