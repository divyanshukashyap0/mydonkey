{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/browse/:id",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": ".*(facebookexternalhit|Facebot|WhatsApp|TelegramBot|Twitterbot|Pinterest|Googlebot|bingbot|Discordbot|Slackbot|LinkedInBot|Applebot|Applebot-Extended|SkypeUriPreview|Embedly|redditbot|vkShare|line|viber|snapchat|meta-externalagent|GPTBot|ChatGPT|ClaudeBot|PerplexityBot|Google-Extended|cohere|CCBot|bytespider).*"
                }
            ],
            "destination": "/api/content-seo?id=:id&type=browse"
        },
        {
            "source": "/watch/:id/season/:season/episode/:episode",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": ".*(facebookexternalhit|Facebot|WhatsApp|TelegramBot|Twitterbot|Pinterest|Googlebot|bingbot|Discordbot|Slackbot|LinkedInBot|Applebot|Applebot-Extended|SkypeUriPreview|Embedly|redditbot|vkShare|line|viber|snapchat|meta-externalagent|GPTBot|ChatGPT|ClaudeBot|PerplexityBot|Google-Extended|cohere|CCBot|bytespider).*"
                }
            ],
            "destination": "/api/content-seo?id=:id&type=watch"
        },
        {
            "source": "/watch/:id",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": ".*(facebookexternalhit|Facebot|WhatsApp|TelegramBot|Twitterbot|Pinterest|Googlebot|bingbot|Discordbot|Slackbot|LinkedInBot|Applebot|Applebot-Extended|SkypeUriPreview|Embedly|redditbot|vkShare|line|viber|snapchat|meta-externalagent|GPTBot|ChatGPT|ClaudeBot|PerplexityBot|Google-Extended|cohere|CCBot|bytespider).*"
                }
            ],
            "destination": "/api/content-seo?id=:id&type=watch"
        },
        {
            "source": "/(movies|tv|anime|categories|exclusive)",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": ".*(facebookexternalhit|Facebot|WhatsApp|TelegramBot|Twitterbot|Pinterest|Googlebot|bingbot|Discordbot|Slackbot|LinkedInBot|Applebot|Applebot-Extended|SkypeUriPreview|Embedly|redditbot|vkShare|line|viber|snapchat|meta-externalagent|GPTBot|ChatGPT|ClaudeBot|PerplexityBot|Google-Extended|cohere|CCBot|bytespider).*"
                }
            ],
            "destination": "/api/content-seo?type=$1"
        },
        {
            "source": "/((?!api/|sitemap.*\\.xml|robots\\.txt|google.*\\.html).*)",
            "destination": "/index.html"
        }
    ]
}