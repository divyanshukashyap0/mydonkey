# ============================================================
# My Donkey OTT — Environment Variables Template
# Copy this file to .env and fill in your own keys.
# NEVER commit the actual .env file to version control.
# ============================================================

# Firebase Configuration
# Get these from: https://console.firebase.google.com → Project Settings → Your Apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Razorpay (Payments)
# Get these from: https://dashboard.razorpay.com → Settings → API Keys
# Use TEST keys for development, LIVE keys only in production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# TMDB (The Movie Database) API Key
# Get yours free at: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# YouTube Data API v3
# Get yours at: https://console.cloud.google.com → APIs & Services → YouTube Data API v3
# YOUTUBE_API_KEY is server-side only (Vercel serverless) — do NOT prefix with VITE_
YOUTUBE_API_KEY=your_youtube_api_key_here
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here
